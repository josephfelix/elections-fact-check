# Backend FactCheck Live (server/). NUNCA commite o .env real.
# Chave da Google AI / Gemini API (https://aistudio.google.com/apikey). Fica somente no backend.
GOOGLE_API_KEY=
# Modelo Gemini usado para transcrição, assuntos, afirmações e checagem.
GEMINI_MODEL=gemini-3.5-flash-lite
# Porta/host. Mantenha 127.0.0.1 para não expor o backend na rede.
HOST=127.0.0.1
PORT=8787
# Token opcional exigido no cabeçalho Authorization: Bearer <token>. Configure o mesmo valor no painel.
BACKEND_TOKEN=
# Timeout por chamada ao modelo (ms)
REQUEST_TIMEOUT_MS=60000
# Cache de checagens (segundos)
CHECK_CACHE_TTL_S=21600

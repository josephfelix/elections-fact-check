{
  "name": "factcheck-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensão Chrome (MV3) para acompanhar transmissões, organizar assuntos e checar afirmações.",
  "scripts": {
    "build": "vite build",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@google/adk": "^2.2.1",
    "fastify": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.290",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
